<?xml version="1.0" encoding="utf-8"?>
<!-- Keep video on its own Hardware Composer layer. The S621 TextureView copy
     path misses 1080p frame deadlines; the player releases and recreates this
     single SurfaceView across lifecycle changes to stay within HWC limits. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="surface_view" />
