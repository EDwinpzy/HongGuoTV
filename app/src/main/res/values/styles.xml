<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/ios_blue</item>
        <item name="android:windowBackground">@color/ios_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@color/ios_background</item>
        <item name="android:statusBarColor">@color/ios_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:alertDialogTheme">@style/AppAlertDialog</item>
        <item name="android:colorControlHighlight">#1FFFFFFF</item>
    </style>

    <style name="AppAlertDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">44%</item>
        <item name="android:windowMinWidthMinor">58%</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:colorAccent">@color/ios_blue</item>
        <item name="android:textColorPrimary">@color/ios_label</item>
        <item name="android:textColorSecondary">@color/ios_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/ios_label</item>
        <item name="android:windowTitleStyle">@style/AppDialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButton</item>
        <item name="android:listPreferredItemHeight">56dp</item>
        <item name="android:listDivider">@null</item>
    </style>

    <style name="AppDialogTitle" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">@color/ios_label</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AppDialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ios_blue</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="TvDialogTheme" parent="@style/AppAlertDialog" />
</resources>
